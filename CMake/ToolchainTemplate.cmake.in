# ==============================================================================
# Generated Toolchain File from ERF Build
# Generated on: @GENERATION_DATE@
# Source directory: @CMAKE_SOURCE_DIR@
# ==============================================================================

# Mark build configuration
set(ERF_GENERATED_TOOLCHAIN TRUE CACHE INTERNAL "Using generated toolchain")

# ==============================================================================
# System Information
# ==============================================================================

set(CMAKE_SYSTEM_NAME "@CMAKE_SYSTEM_NAME@" CACHE STRING "Target system name")
set(CMAKE_SYSTEM_PROCESSOR "@CMAKE_SYSTEM_PROCESSOR@" CACHE STRING "Target system processor")

# ==============================================================================
# Compilers - Set from current build
# ==============================================================================

# C Compiler
if(NOT DEFINED CMAKE_C_COMPILER)
    set(CMAKE_C_COMPILER "@CMAKE_C_COMPILER@" CACHE FILEPATH "C compiler")
endif()

# C++ Compiler
if(NOT DEFINED CMAKE_CXX_COMPILER)
    set(CMAKE_CXX_COMPILER "@CMAKE_CXX_COMPILER@" CACHE FILEPATH "C++ compiler")
endif()

# Fortran Compiler
if(NOT DEFINED CMAKE_Fortran_COMPILER)
    set(CMAKE_Fortran_COMPILER "@CMAKE_Fortran_COMPILER@" CACHE FILEPATH "Fortran compiler")
endif()

# CUDA Compiler (if enabled in current build)
@CUDA_COMPILER_SECTION@

# HIP Compiler (if enabled in current build)
@HIP_COMPILER_SECTION@

# ==============================================================================
# Compiler and Linker Flags from current build
# ==============================================================================

# C Flags
string(APPEND CMAKE_C_FLAGS_INIT "@CMAKE_C_FLAGS@")

# C++ Flags
string(APPEND CMAKE_CXX_FLAGS_INIT "@CMAKE_CXX_FLAGS@")

# Fortran Flags
string(APPEND CMAKE_Fortran_FLAGS_INIT "@CMAKE_Fortran_FLAGS@")

@CUDA_FLAGS_SECTION@
@HIP_FLAGS_SECTION@

# Linker Flags
string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT "@CMAKE_EXE_LINKER_FLAGS@")
string(APPEND CMAKE_SHARED_LINKER_FLAGS_INIT "@CMAKE_SHARED_LINKER_FLAGS@")
string(APPEND CMAKE_MODULE_LINKER_FLAGS_INIT "@CMAKE_MODULE_LINKER_FLAGS@")

# ==============================================================================
# Build Type Settings
# ==============================================================================

if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE "@CMAKE_BUILD_TYPE@" CACHE STRING "Build type" FORCE)
endif()

# ==============================================================================
# MPI Settings (if enabled)
# ==============================================================================

@MPI_SECTION@

# ==============================================================================
# Architecture Settings (for AMReX)
# ==============================================================================

@AMREX_ARCH_SECTION@

# ==============================================================================
# ERF Build Options
# ==============================================================================

set(ERF_ENABLE_MPI @ERF_ENABLE_MPI@ CACHE BOOL "Enable MPI")
set(ERF_ENABLE_OPENMP @ERF_ENABLE_OPENMP@ CACHE BOOL "Enable OpenMP")
set(ERF_ENABLE_CUDA @ERF_ENABLE_CUDA@ CACHE BOOL "Enable CUDA")
set(ERF_ENABLE_HIP @ERF_ENABLE_HIP@ CACHE BOOL "Enable HIP")
set(ERF_ENABLE_SYCL @ERF_ENABLE_SYCL@ CACHE BOOL "Enable SYCL")

# ==============================================================================
# Status Messages
# ==============================================================================

message(STATUS "Generated Toolchain File Loaded")
message(STATUS "  Generated from: @CMAKE_BINARY_DIR@")
message(STATUS "  Build type: @CMAKE_BUILD_TYPE@")
message(STATUS "  Compilers:")
message(STATUS "    C: @CMAKE_C_COMPILER@")
message(STATUS "    C++: @CMAKE_CXX_COMPILER@")
message(STATUS "    Fortran: @CMAKE_Fortran_COMPILER@")
@COMPILER_STATUS_MESSAGES@
message(STATUS "")
message(STATUS "This toolchain file can be used via:")
message(STATUS "  cmake -DCMAKE_TOOLCHAIN_FILE=@OUTPUT_FILE@ <source_dir>")
message(STATUS "  OR")
message(STATUS "  export CMAKE_TOOLCHAIN_FILE=@OUTPUT_FILE@")
message(STATUS "  cmake <source_dir>")